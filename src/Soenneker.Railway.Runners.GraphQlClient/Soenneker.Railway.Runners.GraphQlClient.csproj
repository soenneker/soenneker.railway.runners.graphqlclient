<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.Railway.GraphQlClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Railway.Runners.GraphQlClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="11.0.1464" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageReference Include="Soenneker.GraphQL.Generator" Version="11.0.201" />
        <PackageReference Include="Soenneker.GraphQl.Schema.Conversion" Version="11.0.98" />
        <PackageReference Include="Soenneker.GraphQl.Schema.Download" Version="11.0.182" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="11.0.2722" />
        <PackageReference Include="Soenneker.Utils.File.Download" Version="11.0.1854" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Soenneker.Railway.Runners.GraphQlClient.Tests" />
    </ItemGroup>
</Project>

